# Postgres connection string. For local dev, point this at a free cloud
# Postgres (e.g. Neon.tech) - keeps local and production identical, no local
# DB install needed. For production (Render, etc.) this is provided by your
# hosting provider / database add-on.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

PORT=4000

# The address a customer's phone camera will actually open when scanning a
# printed QR. Must be your real deployed domain in production (e.g.
# https://your-app.onrender.com) - localhost only works when testing from
# this same PC.
APP_PUBLIC_BASE_URL=http://localhost:4000
